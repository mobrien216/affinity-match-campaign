# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Render Postgres "Internal Database URL" (use the External URL + DATABASE_SSL=true when running locally)
DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_SSL=false

# Stripe. Test mode keys start sk_test_ / rk_test_; live start sk_live_ / rk_live_.
# The service decides test vs live from this key and ignores events from the other mode.
STRIPE_SECRET_KEY=rk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Payment Links for each fund (IDs start plink_; URLs are the shareable links). Different in test vs live.
FUND_A_LINK_ID=plink_xxx
FUND_A_LINK_URL=https://buy.stripe.com/test_xxx
FUND_B_LINK_ID=plink_xxx
FUND_B_LINK_URL=https://buy.stripe.com/test_xxx
FUND_C_LINK_ID=plink_xxx
FUND_C_LINK_URL=https://buy.stripe.com/test_xxx

# Campaign window (ISO 8601 with Eastern offset). Only gifts inside the window count.
CAMPAIGN_START=2026-11-01T00:00:00-04:00
CAMPAIGN_END=
# Match goal per fund, in cents ($10,000)
GOAL_CENTS=1000000

# Admin page (/admin) for manual gift entry. Use a long random password.
ADMIN_USER=tcf-admin
ADMIN_PASSWORD=change-me-to-something-long
